# komodo-periphery (remote Periphery agent, outbound mode)
# Periphery -> Core connection. See komodo's periphery.config.toml for full reference.

# The address of Komodo Core. Must be reachable from this host.
# REQUIRED for outbound mode. Example: ws://192.168.1.50:9120 or wss://komodo.example.com:9120
PERIPHERY_CORE_ADDRESS=

# The Server this Periphery agent should connect as.
# Must match an existing Server name or id in Komodo Core.
# Example: my-hostname
PERIPHERY_CONNECT_AS=

# Onboarding Key generated in Komodo Core (Settings -> Onboarding Keys).
# Required to register this Server with the Core on first connect.
# Example: MC4CAQAwBQYDK2VuBCIEIHPHNA/0M9ejFviE2y4dpyczAvnAwPWDQtGGGhEJ2G6K
PERIPHERY_ONBOARDING_KEY=

# Optional custom directory to mount into the Periphery container
PERIPHERY_ADDITIONAL_DIRECTORY=/opt/infra

# Accepted public keys to allow Core(s) to connect (trust the Core's public key).
# Defaults to file:/config/keys/core.pub (core.pub must be present in the keys mount).
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

# Directory where Docker data is stored
DOCKER_DATA_DIR=/opt/infra-data
