# Komodo Core + Periphery environment (v2 key-auth / outbound)

## DB
KOMODO_DB_USERNAME=admin
KOMODO_DB_PASSWORD=admin

## Core
KOMODO_HOST=https://komodo.example.com
KOMODO_TITLE=Komodo
KOMODO_FIRST_SERVER=https://localhost:8120
KOMODO_WEBHOOK_SECRET=
KOMODO_JWT_SECRET=
KOMODO_JWT_TTL="1-day"
KOMODO_LOCAL_AUTH=true
KOMODO_DISABLE_USER_REGISTRATION=false
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=false
KOMODO_TRANSPARENT_MODE=false

## Core accepts this Periphery public key (v2 key auth)
## Can be overridden per-Server.
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
## Public keys of Core(s) that Peripheries may connect to (outbound)
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

## Periphery (same-host agent, outbound mode -> Core)
## Uses network_mode: host for correct network stats; reach Core via localhost
## (Core publishes 9120 on 0.0.0.0).
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_ADDITIONAL_DIRECTORY=/opt/infra
PERIPHERY_CORE_ADDRESS=ws://127.0.0.1:9120
PERIPHERY_CONNECT_AS=
PERIPHERY_ONBOARDING_KEY=
PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
