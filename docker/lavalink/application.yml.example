# Copy to ${DOCKER_DATA_DIR}/${COMPOSE_PROJECT_NAME}/application.yml.
# Lavalink/plugin behavior lives here; Compose owns containers and injects secrets.
# Recreate Lavalink after updating this file and compose.yaml. The old host plugins/
# directory is no longer mounted, so removed plugins (including SponsorBlock) stay removed.

server:
  port: 2333
  address: 0.0.0.0

lavalink:
  plugins:
    - dependency: com.github.topi314.lavasrc:lavasrc-plugin:4.8.3
    - dependency: dev.lavalink.youtube:youtube-plugin:2be8e542d3f6f178e048dca565892684c2e40177
      snapshot: true
  pluginsDir: ./plugins
  server:
    password: ${LAVALINK_SERVER_PASSWORD}
    sources:
      youtube: false
      bandcamp: true
      soundcloud: true
      twitch: true
      vimeo: true
      http: true
      local: false
    bufferDurationMs: 800
    frameBufferDurationMs: 5000
    opusEncodingQuality: 8
    resamplingQuality: MEDIUM
    trackStuckThresholdMs: 10000
    useSeekGhosting: true
    youtubePlaylistLoadLimit: 100
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true
    gc-warnings: true

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    remoteCipher:
      url: http://yt-cipher:8001
      password: ${YT_CIPHER_API_TOKEN}
      userAgent: substiify
    oauth:
      # Use a separate account; without a refreshToken, device authorization starts.
      enabled: true
      refreshToken: ${YOUTUBE_REFRESH_TOKEN:}
    clients:
      - TV
      - TVHTML5_SIMPLY
      - WEB
      - WEBEMBEDDED
      - MUSIC
      - ANDROID_MUSIC
      - ANDROID_VR
  lavasrc:
    providers:
      - 'ytsearch:"%ISRC%"'
      - 'ytmsearch:%QUERY%'
      - 'ytsearch:%QUERY%'
      - 'scsearch:%QUERY%'
    sources:
      spotify: true
      youtube: false
    spotify:
      # Anonymous partner API metadata; providers above supply audio.
      customTokenEndpoint: http://spotify-tokener:8080/api/token
      preferPartnerApi: true
      countryCode: US

logging:
  file:
    path: ./logs/
  level:
    root: INFO
    lavalink: INFO
  logback:
    rollingpolicy:
      max-file-size: 1GB
      max-history: 30
  request:
    enabled: true
    includeClientInfo: true
    includeHeaders: false
    includeQueryString: false
    includePayload: false
