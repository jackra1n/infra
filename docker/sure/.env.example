# Passed to the sure-web, sure-worker and sure-db containers (see env_file in compose.yaml)
DOCKER_DATA_DIR= # Host directory for persistent data (required)

# Database (required)
POSTGRES_USER=sure
POSTGRES_PASSWORD= # Use a unique and secure password
POSTGRES_DB=sure_production

# Encrypts cookies, sessions and stored credentials - generate with `openssl rand -hex 64`
# Changing it after first start invalidates sessions and encrypted columns
SECRET_KEY_BASE=

# The proxy terminates TLS: tell Rails to trust X-Forwarded-Proto, and leave the
# http -> https redirect to the proxy instead of the app
RAILS_ASSUME_SSL=true
RAILS_FORCE_SSL=false

# Domain the app is reachable at, used for links in emails and generated URLs
APP_DOMAIN=sure.example.com

# open | invite_only | closed - keep open for the first signup, then set closed
ONBOARDING_STATE=open

# twelve_data (needs an API key in the app settings) or yahoo_finance (free)
EXCHANGE_RATE_PROVIDER=yahoo_finance
SECURITIES_PROVIDER=yahoo_finance

# Optional: only needed for password resets and email reports
SMTP_ADDRESS=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER=

# Optional: only when using passkeys or security keys. RP ID is the registrable domain,
# origins are full origins. Unset, both are derived from the request host, which is fine
# for a single hostname - but pin them BEFORE registering a passkey, the value is baked
# into the credential.
#WEBAUTHN_RP_ID=example.com
#WEBAUTHN_ALLOWED_ORIGINS=https://sure.example.com
